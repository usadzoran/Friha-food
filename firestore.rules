rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection: public can read, any write allowed for admin management
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Orders collection: public can create, anyone can read/update for store lifecycle
    match /orders/{orderId} {
      allow create: if request.resource.data.customer_name is string
                    && request.resource.data.customer_phone is string
                    && request.resource.data.customer_address is string
                    && request.resource.data.total_price is number;
      allow read, update, delete: if true;
    }

    // Order Items collection
    match /order_items/{itemId} {
      allow create: if request.resource.data.order_id is string
                    && request.resource.data.product_name is string
                    && request.resource.data.quantity is number;
      allow read, update, delete: if true;
    }

    // Analytics / Visitors collection
    match /analytics/{docId} {
      allow read, write: if true;
    }

    // Test connection collection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
