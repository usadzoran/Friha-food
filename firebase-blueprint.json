{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store product available for purchase in Algerian Dinar (DZD)",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Product name" },
        "description": { "type": "string", "description": "Short product description" },
        "price": { "type": "number", "description": "Price in DZD" },
        "image_url": { "type": "string", "description": "URL of the product image" },
        "category_id": { "type": "string", "description": "Optional category ID or section name" },
        "active": { "type": "boolean", "description": "Whether the product is currently visible to customers" },
        "created_at": { "type": "string", "description": "ISO timestamp of creation" }
      },
      "required": ["name", "price", "image_url", "active"]
    },
    "Category": {
      "title": "Category",
      "description": "Store category or section for products",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Category name" },
        "image_url": { "type": "string", "description": "Category cover image URL" },
        "icon": { "type": "string", "description": "Optional icon or symbol name" },
        "created_at": { "type": "string", "description": "ISO creation date" }
      },
      "required": ["name"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "customer_name": { "type": "string", "description": "Full name of the customer" },
        "customer_phone": { "type": "string", "description": "Phone number of the customer" },
        "customer_address": { "type": "string", "description": "Detailed delivery address" },
        "notes": { "type": "string", "description": "Optional customer notes" },
        "total_price": { "type": "number", "description": "Total order amount in DZD" },
        "status": { "type": "string", "enum": ["pending", "accepted", "delivered", "cancelled"], "description": "Order lifecycle status" },
        "created_at": { "type": "string", "description": "Creation ISO timestamp" },
        "updated_at": { "type": "string", "description": "Last update ISO timestamp" }
      },
      "required": ["customer_name", "customer_phone", "customer_address", "total_price", "status"]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Individual line item attached to an order",
      "type": "object",
      "properties": {
        "order_id": { "type": "string", "description": "Reference ID to order document" },
        "product_id": { "type": "string", "description": "Reference ID to product document" },
        "product_name": { "type": "string", "description": "Snapshot of product name at order time" },
        "quantity": { "type": "number", "description": "Quantity ordered" },
        "price": { "type": "number", "description": "Snapshot price per unit in DZD at order time" },
        "subtotal": { "type": "number", "description": "Quantity * price in DZD" }
      },
      "required": ["order_id", "product_name", "quantity", "price", "subtotal"]
    },
    "Analytics": {
      "title": "Analytics",
      "description": "Visitor stats and page view counters",
      "type": "object",
      "properties": {
        "total_visits": { "type": "number", "description": "Total visits count" },
        "unique_visits": { "type": "number", "description": "Total unique session visitors" },
        "today_visits": { "type": "number", "description": "Visits recorded today" },
        "last_visit_date": { "type": "string", "description": "YYYY-MM-DD date string" },
        "last_visit_at": { "type": "string", "description": "ISO timestamp of last visit" }
      }
    },
    "AdSlot": {
      "title": "AdSlot",
      "description": "Custom HTML / script advertising slot",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Ad unit title" },
        "placement": { "type": "string", "description": "Placement identifier" },
        "html_code": { "type": "string", "description": "Raw HTML or script code" },
        "is_active": { "type": "boolean", "description": "Active status of ad" },
        "notes": { "type": "string", "description": "Optional notes or instructions" },
        "created_at": { "type": "string", "description": "ISO creation timestamp" },
        "updated_at": { "type": "string", "description": "ISO update timestamp" }
      },
      "required": ["title", "placement", "html_code", "is_active"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products collection"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Categories collection"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders collection"
    },
    "/order_items/{orderItemId}": {
      "schema": "OrderItem",
      "description": "Order items collection"
    },
    "/analytics/{analyticsId}": {
      "schema": "Analytics",
      "description": "Visitor tracking stats"
    },
    "/ads/{adId}": {
      "schema": "AdSlot",
      "description": "Custom HTML ad units"
    }
  }
}
